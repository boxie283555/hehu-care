<view class="page"><view class="title">建立健康档案</view><view class="sub">每个孩子，都有独立的成长记录。</view><view class="card"><view class="field"><text class="label">姓名或昵称</text><input value="{{form.name}}" bindinput="input" data-key="name" maxlength="40"/></view><view class="field"><text class="label">性别</text><picker range="{{sexes}}" bindchange="picker" data-key="sex"><view class="picker">{{form.sex}}</view></picker></view><view class="field"><text class="label">出生日期</text><picker mode="date" end="{{today}}" value="{{form.birth}}" bindchange="picker" data-key="birth"><view class="picker">{{form.birth || '请选择出生日期'}}</view></picker></view><view class="field"><text class="label">喂养方式</text><picker range="{{feedings}}" bindchange="picker" data-key="feeding"><view class="picker">{{form.feeding}}</view></picker></view><view class="field"><text class="label">过敏信息（疑似或确诊请注明）</text><textarea value="{{form.allergies}}" bindinput="input" data-key="allergies" maxlength="1000" placeholder="没有明确记录可填写不清楚"/></view><view class="field"><text class="label">出生史 / 既往史</text><textarea value="{{form.history}}" bindinput="input" data-key="history" maxlength="1000"/></view><checkbox-group bindchange="consent"><label class="small"><checkbox value="yes" checked="{{consent}}" color="#356f5c"/>我是监护人或已获合法授权，同意将所填信息用于评估与随访。开发版请使用演示资料。</label></checkbox-group></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">建档并继续</button></view>
