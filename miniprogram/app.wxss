page{background:#f6f8f4;color:#293f34;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,input,textarea,button{box-sizing:border-box}.page{padding:40rpx 32rpx 70rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#8a9e8c;margin-bottom:18rpx}.title{font-size:44rpx;font-weight:600;line-height:1.5;margin-bottom:12rpx}.sub{font-size:25rpx;color:#8a9989;line-height:1.8;margin-bottom:32rpx}.card{background:#fffefa;padding:32rpx;border:1rpx solid #e6ece3;border-radius:20rpx;margin-bottom:24rpx}.card-title{font-size:32rpx;font-weight:600;margin-bottom:24rpx}.field{margin-bottom:28rpx}.label{font-size:25rpx;color:#61745d;margin-bottom:12rpx;display:block}input,.picker,textarea{background:#fff;border:1rpx solid #dce5d9;border-radius:12rpx;padding:22rpx;color:#30472f;width:100%;font-size:28rpx}input{height:90rpx}textarea{height:150rpx;line-height:1.7}.picker{min-height:88rpx}button{font-size:28rpx;border-radius:12rpx;margin:0;line-height:1.5;padding:24rpx 30rpx}button::after{border:0}.primary{background:#356f5c;color:#fff}.secondary{background:#edf3e8;color:#356f5c}.plain{color:#68825d;background:transparent}.row{display:flex;align-items:center;gap:20rpx}.grow{flex:1;min-width:0}.small{font-size:23rpx;color:#92a088;line-height:1.8}.notice{background:#f5f2e6;color:#958653;padding:24rpx;border-radius:12rpx;font-size:24rpx;line-height:1.8;margin:24rpx 0}.badge{display:inline-block;font-size:22rpx;color:#6e8f5c;background:#edf3e7;padding:8rpx 14rpx;border-radius:8rpx}.divider{height:1rpx;background:#e6ece1;margin:28rpx 0}.avatar{width:76rpx;height:76rpx;border-radius:24rpx;background:#f6ebe0;color:#ad8862;display:flex;align-items:center;justify-content:center;font-size:32rpx}.section{font-size:28rpx;color:#6e875f;font-weight:600;margin:30rpx 0 24rpx}.checks label{display:flex;align-items:center;gap:12rpx;margin:20rpx 0}.actions{display:flex;gap:18rpx;margin:28rpx 0}.actions button{flex:1}.empty{text-align:center;color:#95a18e;padding:40rpx 12rpx;line-height:1.8}.success{font-size:80rpx;color:#417b60;text-align:center;margin:32rpx}.center{text-align:center}.pre{white-space:pre-wrap;word-break:break-all;line-height:1.8}.record{padding:24rpx 0;border-bottom:1rpx solid #e6ece1}.record:last-child{border:0}.record-title{font-weight:600;margin-bottom:10rpx}.link{color:#356f5c}
